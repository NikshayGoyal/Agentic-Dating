// Prisma Schema for Agentic Dating Site
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id            String   @id @default(uuid())
  name          String
  linkedinUrl   String
  instagramUrl  String
  photoUrl      String?
  category      String?  // tech, creator, designer, fitness, educator
  linkedinData  String?  // JSON string of raw scraped data
  instagramData String?  // JSON string of raw scraped data
  
  profile       Profile?
  
  datesAsPerson1 DateConversation[] @relation("person1")
  datesAsPerson2 DateConversation[] @relation("person2")
  rankingsFor    Ranking[]          @relation("rankedFor")
  rankingsOf     Ranking[]          @relation("rankedPerson")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Profile {
  id                 String   @id @default(uuid())
  personId           String   @unique
  person             Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  tagline            String   // One-line essence of the person
  personalityType    String   // "The Ambitious Dreamer"
  traits             String   // JSON array of strings
  communicationStyle String
  humorType          String
  hobbies            String   // JSON array of strings
  passions           String   // JSON array of strings
  values             String   // JSON array of strings
  lookingFor         String
  greenFlags         String   // JSON array of strings
  dealbreakers       String   // JSON array of strings
  idealDate          String
  icebreaker         String
  controversialTake  String
  summary            String   // Brief overall summary paragraph
  
  createdAt          DateTime @default(now())
}

model DateConversation {
  id             String   @id @default(uuid())
  person1Id      String
  person2Id      String
  person1        Person   @relation("person1", fields: [person1Id], references: [id], onDelete: Cascade)
  person2        Person   @relation("person2", fields: [person2Id], references: [id], onDelete: Cascade)
  
  round          Int      // 1 = vibe check, 2 = speed date
  scenario       String   // The date scenario/theme  
  messages       String   // JSON array of {sender: personId, content: string}
  chemistryScore Float    // 0-100
  highlights     String?  // Best moments from the date
  
  createdAt      DateTime @default(now())

  @@index([person1Id])
  @@index([person2Id])
}

model Ranking {
  id                    String   @id @default(uuid())
  personId              String
  rankedPersonId        String
  person                Person   @relation("rankedFor", fields: [personId], references: [id], onDelete: Cascade)
  rankedPerson          Person   @relation("rankedPerson", fields: [rankedPersonId], references: [id], onDelete: Cascade)
  
  rank                  Int
  overallScore          Float    // 0-100
  headline              String   // "The Power Couple"
  summary               String   // Compatibility narrative
  sharedInterests       String   // JSON array of strings
  complementaryTraits   String   // JSON array of strings
  potentialFriction     String   // JSON array of strings
  bestDateIdea          String
  
  createdAt             DateTime @default(now())
  
  @@unique([personId, rankedPersonId])
  @@index([personId])
}
